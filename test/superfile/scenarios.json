{
    "with_all_extras": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "superfile": {
                "installPreviewTools": true,
                "installClipboardTools": true,
                "installZoxide": true,
                "cdOnQuit": true,
                "nerdfont": true,
                "createAlias": true
            }
        }
    },
    "tools_from_dockerfile": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "superfile": {}
        }
    },
    "explicit_toggles": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "superfile": {
                "metadata": "true",
                "codePreviewer": "bat",
                "zoxideSupport": "true"
            }
        }
    },
    "pinned_without_config": {
        "image": "debian:latest",
        "features": {
            "superfile": {
                "version": "1.6.0",
                "configureDefaults": false
            }
        }
    }
}
