{
    // https://containers.dev/implementors/features/
    "name": "herdr",
    "id": "herdr",
    "version": "1.0.0",
    "description": "Installs herdr, the terminal multiplexer coding agents run on, from its official GitHub release. Seeds a container-friendly config for the remote user, installs herdr's agent skill for Claude Code, and adds bash/zsh shell completions.",
    "documentationURL": "https://github.com/herdrdev/herdr",
    "keywords": ["herdr", "terminal", "multiplexer", "tui", "coding-agents", "cli"],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "0.8.2",
            ],
            "description": "herdr release to install: 'latest' (resolved at build time from upstream's release manifest) or an exact version like '0.8.2' (a leading 'v' is accepted too). See https://github.com/herdrdev/herdr/releases."
        },
        "configureDefaults": {
            "type": "boolean",
            "default": true,
            "description": "Write a container-friendly ~/.config/herdr/config.toml for the remote user (only when no config file exists yet). It sets three keys: 'onboarding = false' skips the first-run wizard, and '[update] version_check = false' plus 'manifest_check = false' stop a disposable container from phoning home to herdr.dev in the background. Set to false to leave configuration entirely to herdr's own defaults."
        },
        "installSkill": {
            "type": "boolean",
            "default": true,
            "description": "Install herdr's agent skill (the release-matched copy printed by 'herdr --skill') to ~/.claude/skills/herdr/SKILL.md for the remote user. The skill teaches a coding agent to drive herdr from inside a pane: split panes, run commands, read output and wait on sibling agents. It guards itself on HERDR_ENV=1, so it stays inert for an agent that is not running inside herdr."
        },
        "installCompletions": {
            "type": "boolean",
            "default": true,
            "description": "Install shell completions generated by 'herdr completion': bash to /usr/share/bash-completion/completions/herdr and zsh to /usr/local/share/zsh/site-functions/_herdr. Both are system-wide standard locations, so no shell rc file is touched."
        },
    },
    // No functional dependency - the Linux release asset is a statically
    // linked (musl, static-PIE) Rust binary with no libc requirement.
    // installsAfter is used purely for build-cache ordering: this Feature
    // tracks the 'latest' release channel by default and changes more often
    // than the Features below. Docker's cache key chains sequentially, so
    // installing last keeps the stable prefix cache-hit even when herdr
    // gets a new release.
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/github-cli",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/sshd",
    ],
}
