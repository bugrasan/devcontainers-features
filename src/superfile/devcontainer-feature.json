{
    // https://containers.dev/implementors/features/
    "name": "superfile",
    "id": "superfile",
    "version": "1.2.0",
    "description": "Installs superfile ('spf'), a modern terminal file manager (TUI), from its official GitHub release. Optionally installs the tools superfile shells out to for previews/clipboard/zoxide, and seeds a container-friendly config for the remote user.",
    "documentationURL": "https://github.com/yorukot/superfile",
    "keywords": ["superfile", "spf", "file-manager", "tui", "terminal", "cli"],
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "1.6.0",
            ],
            "description": "superfile release to install: 'latest' (resolved at build time) or an exact version like '1.6.0' (a leading 'v' is accepted too). See https://github.com/yorukot/superfile/releases."
        },
        "installPreviewTools": {
            "type": "boolean",
            "default": false,
            "description": "Install the tools superfile uses for rich previews: ffmpeg (video thumbnails), poppler-utils (PDF thumbnails via pdftoppm), exiftool (the 'metadata' plugin) and bat (syntax-highlighted code preview). Adds a few hundred MB to the image. Leave this off when your base image already provides the tools - the 'metadata' and 'codePreviewer' options below default to detecting them on PATH regardless of who installed them."
        },
        "installClipboardTools": {
            "type": "boolean",
            "default": false,
            "description": "Install xdg-utils (xdg-open, for 'open with the default application'), xclip and wl-clipboard. These are mostly no-ops in a headless container but are small and stop superfile's --debug-info from reporting them as missing."
        },
        "installZoxide": {
            "type": "boolean",
            "default": false,
            "description": "Install zoxide for smart directory jumping inside superfile. Leave off when your base image already provides zoxide - the 'zoxideSupport' option below defaults to detecting it on PATH regardless of who installed it."
        },
        "metadata": {
            "type": "string",
            "default": "auto",
            "proposals": [
                "auto",
                "true",
                "false",
            ],
            "enum": [
                "auto",
                "true",
                "false",
            ],
            "description": "superfile's detailed-metadata plugin, which requires exiftool. 'auto' (default) enables it when exiftool is on PATH at install time - no matter who installed it - so a base image that apt-installs exiftool in its own Dockerfile gets the plugin without this Feature also pulling in a preview toolchain it already has. 'true' forces it on (warns if exiftool is missing); 'false' forces it off. Ignored when configureDefaults is false."
        },
        "codePreviewer": {
            "type": "string",
            "default": "auto",
            "proposals": [
                "auto",
                "bat",
                "builtin",
            ],
            "enum": [
                "auto",
                "bat",
                "builtin",
            ],
            "description": "Which syntax highlighter superfile previews code with. 'auto' (default) uses bat when it is on PATH at install time, whoever installed it, and otherwise falls back to superfile's builtin chroma highlighter. 'bat' forces bat (warns if missing); 'builtin' forces chroma. Ignored when configureDefaults is false."
        },
        "zoxideSupport": {
            "type": "string",
            "default": "auto",
            "proposals": [
                "auto",
                "true",
                "false",
            ],
            "enum": [
                "auto",
                "true",
                "false",
            ],
            "description": "superfile's zoxide integration for smart directory jumping. 'auto' (default) enables it when zoxide is on PATH at install time, whoever installed it. 'true' forces it on (warns if zoxide is missing); 'false' forces it off. Ignored when configureDefaults is false."
        },
        "configureDefaults": {
            "type": "boolean",
            "default": true,
            "description": "Write a small container-friendly ~/.config/superfile/config.toml for the remote user (only when no config file exists yet). Its most important effect is 'auto_check_update = false', so a throwaway dev container never phones home to the GitHub API on startup. Set to false to leave configuration entirely to superfile's own first-run defaults."
        },
        "nerdfont": {
            "type": "boolean",
            "default": false,
            "description": "Value for superfile's 'nerdfont' setting in the generated config (ignored when configureDefaults is false). superfile itself defaults this to true, but the terminal font lives on the HOST, not in the container, so a terminal without a Nerd Font-patched font renders superfile's icons as tofu boxes. This Feature therefore defaults to the safe value; set it to true when your terminal does use a patched font and you want the icons."
        },
        "cdOnQuit": {
            "type": "boolean",
            "default": false,
            "description": "Enable superfile's 'cd on quit': sets 'cd_on_quit = true' in the generated config (requires configureDefaults) and installs upstream's spf() shell wrapper into the remote user's ~/.bashrc / ~/.zshrc, so leaving superfile changes the shell's directory. Off by default because the wrapper shadows the 'spf' command and edits the user's shell rc files."
        },
        "createAlias": {
            "type": "boolean",
            "default": false,
            "description": "Also expose the binary as 'superfile' (a symlink to /usr/local/bin/spf). Off by default so the Feature installs exactly what upstream does, and nothing else lands on PATH under a name superfile does not own. Set to true if you would rather type the long name."
        },
    },
    // No functional dependency - the release asset is a statically linked
    // (CGO_ENABLED=0) Go binary, and the optional tools above come from apt.
    // installsAfter is used purely for build-cache ordering: this Feature
    // tracks the 'latest' release channel by default and changes more often
    // than the Features below. Docker's cache key chains sequentially, so
    // installing last keeps the stable prefix cache-hit even when superfile
    // gets a new release.
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/github-cli",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/sshd",
    ],
}
