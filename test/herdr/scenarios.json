{
    "minimal": {
        "image": "debian:latest",
        "features": {
            "herdr": {
                "configureDefaults": false,
                "installCompletions": false,
                "installCore": false
            }
        }
    },
    "existing_config": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "remoteUser": "vscode",
        "features": {
            "herdr": {}
        }
    },
    "core_pinned": {
        "image": "debian:latest",
        "features": {
            "herdr": {
                "coreVersion": "v0.1.20"
            }
        }
    },
    "existing_hc": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "herdr": {}
        }
    },
    "core_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "herdr": {
                "installTui": false
            }
        }
    },
    "skills_copilot_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "features": {
            "herdr": {
                "installTuiSkill": true,
                "skillClaudeCode": false
            }
        }
    },
    "skills_tui_claude_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "features": {
            "herdr": {
                "installTuiSkill": true,
                "installCoreSkill": false,
                "skillCopilot": false
            }
        }
    },
    "no_harness": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "herdr": {
                "installTuiSkill": true,
                "skillClaudeCode": false,
                "skillCopilot": false
            }
        }
    },
    "existing_core": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "herdr": {
                "coreVersion": "0.1.20"
            }
        }
    }
}
