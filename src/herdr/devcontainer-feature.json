{
    // https://containers.dev/implementors/features/
    "name": "herdr",
    "id": "herdr",
    "version": "3.1.0",
    "description": "Installs the herdr TUI ('herdr') and herdr-core ('hc') by running upstream's official install scripts unchanged, both optional, into the remote user's ~/.local/bin. Seeds a container-friendly herdr config, adds bash/zsh completions, and installs agent skills for Claude Code and GitHub Copilot CLI.",
    "documentationURL": "https://github.com/herdrdev/herdr",
    "keywords": ["herdr", "herdr-core", "hc", "terminal", "multiplexer", "tui", "coding-agents", "cli"],
    "options": {
        "installTui": {
            "type": "boolean",
            "default": true,
            "description": "Install the herdr TUI, the terminal app run as 'herdr', by running upstream's official install script (https://herdr.dev/install.sh) unchanged as the remote user. It installs to upstream's default ~/.local/bin/herdr, which may not be on PATH. The script always installs the latest release; it cannot pin a version."
        },
        "configureDefaults": {
            "type": "boolean",
            "default": true,
            "description": "With 'installTui': copy the Feature's container-friendly herdr/config.toml to ~/.config/herdr/config.toml for the remote user (only when no config file exists yet). It sets three keys: 'onboarding = false' skips the first-run wizard, and '[update] version_check = false' plus 'manifest_check = false' stop a disposable container from phoning home to herdr.dev in the background. Set to false to leave configuration entirely to herdr's own defaults."
        },
        "disableTuiUpdates": {
            "type": "boolean",
            "default": true,
            "description": "With 'installTui' and 'configureDefaults': keep the '[update]' section (version_check = false, manifest_check = false) in the copied config, so herdr does not check herdr.dev for a newer release or agent manifest. Set to false to drop that section and keep herdr's own update checks; 'onboarding = false' is copied either way."
        },
        "installCompletions": {
            "type": "boolean",
            "default": true,
            "description": "With 'installTui': install shell completions generated by 'herdr completion': bash to /usr/share/bash-completion/completions/herdr and zsh to /usr/local/share/zsh/site-functions/_herdr. Both are system-wide standard locations, so no shell rc file is touched."
        },
        "installTuiSkill": {
            "type": "boolean",
            "default": false,
            "description": "With 'installTui': install herdr's agent skill (printed by 'herdr --skill') for the agents chosen by 'skillClaudeCode' and 'skillCopilot'. It teaches an agent to drive herdr from inside a pane, and guards itself on HERDR_ENV=1."
        },
        "installCore": {
            "type": "boolean",
            "default": true,
            "description": "Install herdr-core, the headless core run as 'hc', by running upstream's official install script (https://releases.herdr.dev/core/install.sh) unchanged as the remote user. It installs to upstream's default ~/.local/bin: 'herdr-core' plus an 'hc' link when no other 'hc' exists. That directory may not be on PATH."
        },
        "coreVersion": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "0.1.21",
            ],
            "description": "With 'installCore': herdr-core release to install, 'latest', or an exact version like '0.1.21' (a leading 'v' is accepted too). Passed to upstream's script as HC_VERSION."
        },
        "disableCoreUpdates": {
            "type": "boolean",
            "default": true,
            "description": "Block 'hc update' and 'hc machine add' downloads through the empty HERDR_RELEASES_URL that this Feature sets in containerEnv (workaround: herdr-core has no config key for this yet). Set to false to unset the variable again in shells (/etc/profile.d, /etc/bash.bashrc, and /etc/zsh/zshenv), so 'hc update' reaches releases.herdr.dev. Applies whether or not 'installCore' is set."
        },
        "installCoreSkill": {
            "type": "boolean",
            "default": true,
            "description": "With 'installCore': install upstream's herdr-core agent skill (from the installed version's tag on GitHub) for the agents chosen by 'skillClaudeCode' and 'skillCopilot'. Outside an hc terminal it tells the agent to ask the user once whether to use hc. Upstream publishes the skill from herdr-core 0.1.13 on; an older 'coreVersion' fails the build unless this is false."
        },
        "skillClaudeCode": {
            "type": "boolean",
            "default": true,
            "description": "Install the enabled agent skills for Claude Code, at ~/.claude/skills/<name>/SKILL.md for the remote user."
        },
        "skillCopilot": {
            "type": "boolean",
            "default": true,
            "description": "Install the enabled agent skills for GitHub Copilot CLI, at ~/.copilot/skills/<name>/SKILL.md for the remote user."
        },
    },
    // WORKAROUND: herdr-core has no config key to disable 'hc update' yet; an
    // empty HERDR_RELEASES_URL blocks it. 'disableCoreUpdates: false' unsets it
    // in shells (install.sh). Remove once upstream adds a config key.
    "containerEnv": {
        "HERDR_RELEASES_URL": ""
    },
    // No functional dependency - the Linux release asset is a statically
    // linked (musl, static-PIE) Rust binary with no libc requirement.
    // installsAfter is used purely for build-cache ordering: this Feature
    // always installs the latest herdr TUI and changes more often
    // than the Features below. Docker's cache key chains sequentially, so
    // installing last keeps the stable prefix cache-hit when this Feature
    // changes. A cached layer never notices a new upstream release - rebuild
    // without cache (--no-cache) to pick one up.
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/copilot-cli",
        "ghcr.io/bugrasan/devcontainers-features/claude-code",
        "ghcr.io/devcontainers/features/github-cli",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/sshd",
    ],
}
