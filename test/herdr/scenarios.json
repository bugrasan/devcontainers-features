                "configureDefaults": false,
                "installCompletions": false,
                "installCore": false
            }
        }
    },
    "existing_config": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "remoteUser": "vscode",
        "features": {
            "herdr": {}
        }
    },
    "core_pinned": {
        "image": "debian:latest",
        "features": {
            "herdr": {
                "coreVersion": "v0.1.20",
                "installCoreSkill": false
            }
        }
    },
    "existing_hc": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "herdr": {
                "installCoreSkill": false
            }
        }
    },
    "core_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "herdr": {
                "installTui": false
            }
        }
    },
    "skills_copilot_only": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "features": {
            "herdr": {
                "installTuiSkill": true,
                "skillClaudeCode": false
            }
        }
    }
